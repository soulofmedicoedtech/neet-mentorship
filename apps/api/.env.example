# Local development only. Never commit real credentials.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/praxis_dev?schema=public
# Replace with a unique random secret (32+ characters); never reuse this example in production.
JWT_SECRET=local-development-only-secret-change-before-use-32chars
\n# Comma-separated browser origins allowed to call the API (local defaults are safe for development only)\nCORS_ORIGINS=http://localhost:5173,http://localhost:4173\n