generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum MentorshipApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  DECLINED
  WITHDRAWN
}

enum ContentPublicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
}

enum LearningResourceType {
  PDF
  EXTERNAL_LINK
}

enum AcademicRole {
  SUPER_ADMIN
  ADMIN
  ACADEMIC_ADMIN
  FACULTY
  CONTENT_MANAGER
  QUESTION_BANK_MANAGER
  VIDEO_MANAGER
  FINANCE_MANAGER
  SUPPORT_EXECUTIVE
  MODERATOR
  STUDENT
}

model User {
  id             String          @id @default(cuid())
  email          String?         @unique
  phoneE164      String?         @unique
  passwordHash   String?
  displayName    String
  status         UserStatus      @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          UserRole[]
  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  sessions       DeviceSession[]
  auditEvents    AuditEvent[]    @relation("AuditActor")
  assignedApplications MentorshipApplication[] @relation("AssignedMentor")
  courseAssignments CourseFacultyAssignment[]
  authoredLectures Lecture[] @relation("LectureAuthor")
  uploadedLearningResources LearningResource[] @relation("LearningResourceAuthor")
}

model Role {
  id          String           @id @default(cuid())
  key         AcademicRole      @unique
  description String?
  assignments UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  professionalYear   String?
  university         String?
  targetExaminations String[] @default([])
  preferredLanguage  String?
  collegeId          String?
  college            College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  applications       MentorshipApplication[]
  courseEnrollments  CourseEnrollment[]
  lectureProgress    LectureProgress[]
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model College {
  id          String          @id @default(cuid())
  name        String
  state       String
  university  String?
  collegeType String?
  active      Boolean         @default(true)
  students    StudentProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([name, state])
  @@index([state, active])
  @@index([university, active])
}

model MentorshipApplication {
  id                String                       @id @default(cuid())
  studentProfileId  String
  goal              String
  challenge         String?
  preferredContact  String?
  status            MentorshipApplicationStatus  @default(PENDING)
  assignedMentorId  String?
  assignedMentor    User?                        @relation("AssignedMentor", fields: [assignedMentorId], references: [id], onDelete: SetNull)
  mentorReviewNote  String?
  assignedAt        DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  studentProfile    StudentProfile               @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, createdAt])
  @@index([status, createdAt])
  @@index([assignedMentorId, status, createdAt])
}

model FacultyProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  qualifications String[] @default([])
  specialties    String[] @default([])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceSession {
  id          String    @id @default(cuid())
  userId      String
  deviceLabel String?
  refreshHash String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  units       Unit[]
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Unit {
  id        String    @id @default(cuid())
  subjectId String
  title     String
  sortOrder Int       @default(0)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters  Chapter[]

  @@index([subjectId, sortOrder])
}

model Chapter {
  id        String   @id @default(cuid())
  unitId    String
  title     String
  sortOrder Int      @default(0)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topics    Topic[]

  @@index([unitId, sortOrder])
}

model Topic {
  id        String  @id @default(cuid())
  chapterId String
  title     String
  sortOrder Int     @default(0)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lectures  Lecture[]

  @@index([chapterId, sortOrder])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
}


model Course {
  id          String                   @id @default(cuid())
  code        String                   @unique
  title       String
  description String?
  subjectId   String
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  subject     Subject                  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty     CourseFacultyAssignment[]
  lectures    Lecture[]
  enrollments CourseEnrollment[]

  @@index([subjectId, active])
}

model CourseFacultyAssignment {
  id         String   @id @default(cuid())
  courseId   String
  facultyId  String
  assignedBy String
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty    User     @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyId])
  @@index([facultyId, createdAt])
}


model Lecture {
  id          String                    @id @default(cuid())
  courseId    String
  topicId     String?
  authorId    String
  title       String
  description String?
  videoUrl    String?
  videoType   String?
  durationSec Int?
  sortOrder   Int                       @default(0)
  status      ContentPublicationStatus  @default(DRAFT)
  reviewNote  String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  course      Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic       Topic?                    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  author      User                      @relation("LectureAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  resources   LearningResource[]
  progress    LectureProgress[]

  @@index([courseId, status, sortOrder])
  @@index([authorId, createdAt])
}

model LearningResource {
  id          String                    @id @default(cuid())
  lectureId   String
  authorId    String
  title       String
  type        LearningResourceType
  url         String
  description String?
  sortOrder   Int                       @default(0)
  status      ContentPublicationStatus  @default(DRAFT)
  reviewNote  String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  lecture     Lecture                   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  author      User                      @relation("LearningResourceAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([lectureId, status, sortOrder])
  @@index([authorId, createdAt])
}


model CourseEnrollment {
  id               String         @id @default(cuid())
  studentProfileId String
  courseId         String
  enrolledAt       DateTime       @default(now())
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, courseId])
  @@index([studentProfileId, enrolledAt])
  @@index([courseId, enrolledAt])
}

model LectureProgress {
  id               String         @id @default(cuid())
  studentProfileId String
  lectureId        String
  watchedSeconds   Int            @default(0)
  completedAt      DateTime?
  lastViewedAt     DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  lecture          Lecture        @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, lectureId])
  @@index([studentProfileId, updatedAt])
  @@index([lectureId])
}
